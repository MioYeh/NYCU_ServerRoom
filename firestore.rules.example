rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCommittee() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'committee';
    }

    // 審核者（管理員或機房主委）
    function isReviewer() {
      return isAdmin() || isCommittee();
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function sameUnit(unitValue) {
      return hasProfile()
        && unitValue is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unit == unitValue;
    }

    // 使用者 profile：本人可讀；本人可更新 displayName；僅 admin 可改 role 或管理他人
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // create 分兩種：
      // 1) 本人首次登入建立基本資料（固定 role=user，不能自提權）
      // 2) 管理員在後台新增使用者時，代為建立 profile（可指定角色與所屬單位）
      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == 'user'
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'unit'])
        );

      // 本人只能改 displayName；admin 可改任何欄位（包含 role、unit）
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'unit'])
        );

      allow delete: if isAdmin();
    }

    // ===== 舊路徑關閉 =====
    // devices / applications 已完成遷移至單筆文件結構，舊路徑關閉。
    match /collections/devices {
      allow read, write: if false;
    }

    // 新結構（建議）：每台設備一筆文件，支援同單位可見
    match /devices/{deviceId} {
      // admin/committee 可看全部；一般使用者可看同單位設備
      allow read: if isReviewer() || sameUnit(resource.data.unit);
      // 設備新增/修改/刪除由 admin 控制
      allow create, update, delete: if isAdmin();
    }

    // 新結構（建議）：每張申請單一筆文件
    match /applications/{appId} {
      // 一般使用者送件：只能送自己的，且 applicantUnit 需與個人 profile 一致
      // reviewer（admin/committee）可建立任意申請（供資料遷移與後台流程）
      allow create: if isReviewer()
        || (
          isSignedIn()
          && request.resource.data.submittedBy == request.auth.uid
          && sameUnit(request.resource.data.applicantUnit)
        );

      // 審核者可看全部；一般使用者可看自己的申請，以及同單位其他人的申請（供繳費申請頁列出可續約設備）
      allow read: if isReviewer()
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid)
        || sameUnit(resource.data.applicantUnit);

      // reviewer 可更新任何申請；本人僅可更新自己且仍為 pending 的申請（避免審核後被修改）
      // 另：本人對已核准/上架申請，可只更新「繳費欄位」做自報繳費
      allow update: if isReviewer()
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.submittedBy == resource.data.submittedBy
        )
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && (resource.data.status == 'approved' || resource.data.status == 'installed')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'paymentDate', 'paymentMethod', 'paymentRef',
              'paidAmount', 'paidUpTo', 'paidAt', 'paidBy'
            ])
        );

      // reviewer 可刪除任何申請；本人僅可刪除自己且仍為 pending 的申請
      allow delete: if isReviewer()
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    match /collections/applications {
      allow read, write: if false;
    }

    match /collections/ownerUnits {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /collections/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ===== 建議未來改版（更細權限 + 同單位可見） =====
    // 目標：
    // - applications 改為 applications/{appId}
    // - devices 改為 devices/{deviceId}
    // - 一般使用者可看「同單位」設備，不限同一個人
    //
    // 假設資料欄位：
    // - users/{uid}.unit
    // - applications/{appId}.submittedBy, applications/{appId}.applicantUnit
    // - devices/{deviceId}.unit
    //
    // 可先註解保留，待資料模型切換完成後啟用。

    // match /devices/{deviceId} {
    //   // admin/committee 可看全部；一般使用者可看同單位設備
    //   allow read: if isReviewer() || sameUnit(resource.data.unit);

    //   // 設備新增/修改/刪除由 admin 控制
    //   allow create, update, delete: if isAdmin();
    // }
  }
}
